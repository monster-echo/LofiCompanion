# Public application identity
AUTH_PUBLIC_ORIGIN=http://localhost:3210
AUTH_DEFAULT_APP_ID=zhongbei

# JWT access token（RS256 自校验）。业务服务（如 dsh-companion gateway）
# 经 GET /api/v1/auth/jwks 取公钥本地验签。
# 生成：openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt-private.pem
# 未配置时仅 development 可运行（自动生成临时密钥 .dev-jwt-key.pem）。
AUTH_JWT_PRIVATE_KEY=
AUTH_JWT_ISSUER=
AUTH_JWT_AUDIENCE=dsh-pocket

# PostgreSQL connection. DATABASE_URL is also accepted as a fallback.
AUTH_DATABASE_URL=postgresql://zhongbei_auth:change-me@localhost:5432/zhongbei_auth
AUTH_DATABASE_POOL_SIZE=10
# Compose reads this separately. Change both database passwords for production.
ZHONGBEI_AUTH_POSTGRES_PASSWORD=change-me

# Replace every local-development value before production deployment.
MOBILEUI_ADMIN_KEY=replace-with-a-long-random-secret
MOBILEUI_PHONE_PEPPER=replace-with-a-long-random-secret
MOBILEUI_RESET_PEPPER=replace-with-a-long-random-secret

# Optional delivery providers
MOBILEUI_EMAIL_ENDPOINT=
MOBILEUI_EMAIL_API_KEY=
MOBILEUI_SMS_ENDPOINT=
MOBILEUI_SMS_API_KEY=
MOBILEUI_FCM_TENANTS_JSON=

# HMAC secret used to sign entitlement tokens (POST /api/v1/me/entitlement).
# Must be shared with each app-specific backend that verifies Pro status.
ENTITLEMENT_SIGNING_SECRET=

# Huawei Account Kit one-tap login (getPhoneNumber). geekread 等 HarmonyOS app 用。
HUAWEI_OAUTH_CLIENT_ID=
HUAWEI_OAUTH_CLIENT_SECRET=

# 阿里云短信（验证码直发，auth 内直接调用，无需外部网关）
# 配置了 MOBILEUI_ALIYUN_ACCESS_KEY_ID 即启用阿里云直发；否则回退 MOBILEUI_SMS_ENDPOINT。
MOBILEUI_ALIYUN_ACCESS_KEY_ID=
MOBILEUI_ALIYUN_ACCESS_KEY_SECRET=
MOBILEUI_ALIYUN_SIGN_NAME=
MOBILEUI_ALIYUN_TEMPLATE_CODE=
MOBILEUI_ALIYUN_REGION=cn-hangzhou

# ── S3-compatible object storage (BaaS: multi-tenant, bucket per app_id) ──
# Implementation-agnostic — works with MinIO / Tencent COS / Alibaba OSS /
# Cloudflare R2 / AWS S3. Clients upload via presigned URL.
#
# Two isolation modes (set ONE):
#  • S3_BUCKET       → single shared bucket; appId isolates via key prefix
#                      (<appId>/<env>/<path>). New apps need zero provisioning.
#                      Recommended for OSS (one bucket, one RAM grant).
#  • S3_BUCKET_PREFIX → one bucket per app (${prefix}${appId}). Strongest
#                      isolation but each app must be provisioned on the backend.
#
# Alibaba OSS example (single-bucket mode, S3-compatible):
#   S3_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
#   S3_REGION=oss-cn-hangzhou
#   S3_ACCESS_KEY_ID=<阿里云 RAM AccessKey ID>
#   S3_SECRET_ACCESS_KEY=<阿里云 RAM AccessKey Secret>
#   S3_BUCKET=zhongbei-storage        (在 OSS 控制台预创建一个 bucket 即可)
#   S3_FORCE_PATH_STYLE=false         (OSS 用虚拟域名)
S3_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_BUCKET_PREFIX=app-
# MinIO & self-hosted need path-style; set "false" for AWS S3 / Alibaba OSS virtual-host.
S3_FORCE_PATH_STYLE=true
# Optional public/CDN base for direct object URLs (skip presigned download).
# e.g. https://cdn.zhongbei.tech  →  https://cdn.zhongbei.tech/app-geekread/dev/...
S3_PUBLIC_BASE=

# 服务间内部接口密钥（biz-server 调 /v1/internal/profiles 用；两侧须一致）
INTERNAL_API_KEY=
