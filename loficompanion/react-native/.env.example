# React Native 客户端环境变量（复制为 .env 并填写）
# 三个必填，未配置则启动即报错退出（见 README「应用身份」）。

# 该 App 的租户 id（服务端按此隔离数据）
EXPO_PUBLIC_APP_ID=loficompanion

# 运行环境：development / staging / production
EXPO_PUBLIC_APP_ENVIRONMENT=development

# 后端 API 基地址（默认本地 http://localhost:3210）
EXPO_PUBLIC_API_URL=https://auth.zhongbei.tech

# 业务后端（biz-server）独立地址；未配置回落 EXPO_PUBLIC_API_URL
# EXPO_PUBLIC_BIZ_API_URL=http://localhost:3320

# 自习室 WebSocket（生产必填，缺省启动即抛；开发缺省 ws://localhost:3321，
# 安卓模拟器自动用 10.0.2.2；省略路径时自动补 /studyroom）
# EXPO_PUBLIC_STUDYROOM_WS_URL=wss://lofi-biz.zhongbei.tech/studyroom
