{
  "name": "loficompanion-biz",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3320",
    "dev:ws": "node --env-file-if-exists=.env --import ./src/ws/register.mjs --experimental-transform-types src/ws/server.ts",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 3320",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --import ./tests/register.mjs --test --experimental-transform-types tests/*.test.ts",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1121.0",
    "@aws-sdk/s3-request-presigner": "^3.1121.0",
    "@prisma/client": "^6.10.0",
    "jose": "^6.1.2",
    "next": "^16.2.12",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "ws": "^8.21.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.1",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.2.12",
    "prisma": "^6.10.0",
    "typescript": "^5.9.3"
  }
}
