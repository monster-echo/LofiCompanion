// Lofi Companion 业务 schema（对齐 server/src/server/database-schema-lofi.ts 的迁移口径）。
// 约定：userId 为对基础设施用户的逻辑外键（auth.zhongbei.tech JWT sub），不建关系；
// 字段名直接用 snake_case——与服务端既有代码/客户端线格式逐字段一致，搬迁零映射层；
// 时间戳沿用 ISO 字符串；JSON 沿用 TEXT 存储（pauses/rankings/manifest）；
// CHECK 约束由路由层校验承担。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── 专注会话云同步（docs/04 §1）──────────────────────────────────────────

model FocusSession {
  id               String  @id
  user_id          String  @map("user_id")
  installation_id  String? @map("installation_id")
  activity         String
  planned_seconds  Int     @map("planned_seconds")
  status           String
  started_at       String  @map("started_at")
  ended_at         String? @map("ended_at")
  effective_seconds Int    @default(0) @map("effective_seconds")
  pauses           String  @default("[]")
  client_request_id String @map("client_request_id")
  rule_version     Int     @default(1) @map("rule_version")
  created_at       String  @map("created_at")
  updated_at       String  @map("updated_at")

  @@unique([user_id, client_request_id])
  @@index([user_id, started_at])
  @@map("focus_sessions")
}

// 通用变更幂等层：完成/迁移等 mutation 以 (key, user_id, endpoint) 去重
model IdempotencyKey {
  key           String @map("key")
  user_id       String @map("user_id")
  endpoint      String @map("endpoint")
  response_body String @map("response_body")
  status_code   Int    @map("status_code")
  created_at    String @map("created_at")

  @@id([key, user_id, endpoint])
  @@map("idempotency_keys")
}

// ── 成就账本与房间收藏物（docs/01 §5.6）──────────────────────────────────

// 同一成就同一规则版本只发放一次
model AchievementGrant {
  id                String  @id
  user_id           String  @map("user_id")
  rule_key          String  @map("rule_key")
  rule_version      Int     @default(1) @map("rule_version")
  source_session_id String? @map("source_session_id")
  granted_at        String  @map("granted_at")

  @@unique([user_id, rule_key, rule_version])
  @@map("achievement_grants")
}

// 收藏物目录（种子：书签/台灯/绿植/合影/周目标合影）
model RoomItem {
  id            String @id
  item_id       String @unique @map("item_id")
  name          String
  source_rule_key String @map("source_rule_key")

  @@map("room_items")
}

model UserRoomItem {
  user_id        String  @map("user_id")
  room_item_id   String  @map("room_item_id")
  source_grant_id String? @map("source_grant_id")
  unlocked_at    String  @map("unlocked_at")

  @@unique([user_id, room_item_id])
  @@map("user_room_items")
}

// ── 好友与学习小组（docs/06 P0-C，端点 P3b 搬迁）──────────────────────────

// 好友邀请码：每人一个有效码；8 位可读码全局唯一
model FriendInvitation {
  id        String @id
  user_id   String @unique @map("user_id")
  code      String @unique
  created_at String @map("created_at")

  @@map("friend_invitations")
}

// 好友关系双向两行（A→B 与 B→A 同事务写入）
model Friendship {
  id         String @id
  user_id    String @map("user_id")
  friend_id  String @map("friend_id")
  created_at String @map("created_at")

  @@unique([user_id, friend_id])
  @@index([friend_id])
  @@map("friendships")
}

// 私密自习小组：加入码制，共同目标 = 周目标分钟
model StudyGroup {
  id                  String @id
  name                String
  owner_user_id       String @map("owner_user_id")
  join_code           String @unique @map("join_code")
  weekly_goal_minutes Int    @default(600) @map("weekly_goal_minutes")
  created_at          String @map("created_at")

  @@map("study_groups")
}

model GroupMember {
  group_id  String @map("group_id")
  user_id   String @map("user_id")
  role      String @default("member")
  joined_at String @map("joined_at")

  @@unique([group_id, user_id])
  @@index([user_id])
  @@map("group_members")
}

// ── 排行榜（分账本派生 + 不可变周快照 + 隐私）────────────────────────────

// 分账本：从 focus_sessions 派生（rule_version=2 含每日 180 分钟上限），原子 upsert
model LeaderboardScore {
  user_id           String @map("user_id")
  scope_type        String @map("scope_type")
  scope_id          String @map("scope_id")
  week_id           String @map("week_id")
  effective_seconds Int    @default(0) @map("effective_seconds")
  session_count     Int    @default(0) @map("session_count")
  rule_version      Int    @default(2) @map("rule_version")
  updated_at        String @map("updated_at")

  @@id([user_id, scope_type, scope_id, week_id, rule_version])
  @@map("leaderboard_scores")
}

// 周快照不可变（周末后惰性结算写入；rankings JSON 只含昵称/头像/分钟/名次）
model LeaderboardSnapshot {
  id           String @id
  scope_type   String @map("scope_type")
  scope_id     String @map("scope_id")
  week_id      String @map("week_id")
  rankings     String
  settled_at   String @map("settled_at")
  rule_version Int    @default(2) @map("rule_version")

  @@unique([scope_type, scope_id, week_id, rule_version])
  @@map("leaderboard_snapshots")
}

// 榜单隐私：public_display=0 隐藏昵称仍参与排名；opted_out=1 从榜单消失
model LeaderboardSettings {
  user_id        String @id @map("user_id")
  public_display Int    @default(1) @map("public_display")
  opted_out      Int    @default(0) @map("opted_out")
  updated_at     String @map("updated_at")

  @@map("leaderboard_settings")
}

// ── 皮肤目录与版本化 manifest（发布通道数据；商品/订单留在 auth）──────────

model Skin {
  id               String  @id
  slug             String  @unique
  name             String
  access_type      String  @default("free") @map("access_type")
  manifest_version Int     @default(1) @map("manifest_version")
  moderation_status String @default("approved") @map("moderation_status")
  published_at     String? @map("published_at")
  created_at       String  @map("created_at")

  manifests SkinManifest[]

  @@map("skins")
}

// manifest 版本只增不改：同一 (skin_id, version) 不可覆盖
model SkinManifest {
  id         String @id
  skin_id    String @map("skin_id")
  version    Int
  manifest   String
  created_at String @map("created_at")

  skin Skin @relation(fields: [skin_id], references: [id])

  @@unique([skin_id, version])
  @@map("skin_manifests")
}

// ── 自习室弹幕（WS 服务 src/ws/server.ts 写入；id 为单调游标）──────────────

// 仅登录用户可发送；访客只读。id 用 Int 自增而非 BigInt：
// JSON.stringify(BigInt) 会抛，WS 线格式全程 JSON 文本帧。
model StudyRoomMessage {
  id         Int    @id @default(autoincrement())
  room_id    String @map("room_id")
  user_id    String @map("user_id")
  content    String
  created_at String @map("created_at")

  @@index([room_id, id])
  @@map("study_room_messages")
}

// ── 皮肤商店（P4 自基础设施 auth 迁入；skin.official.* 所有权数据归 biz）────

// 商品行：价格/SKU/权益键是商店目录与门禁依据。provider 是业务启用标识
//（'mock'=模拟支付仅开发；'store'=原生商店 IAP，验证按客户端平台分流）。
model SkinProduct {
  id                String @id
  skin_id           String @map("skin_id")
  slug              String
  skin_name         String @map("skin_name")
  access_type       String @default("paid") @map("access_type")
  entitlement_key   String @map("entitlement_key")
  store_product_ids String @default("{}") @map("store_product_ids")
  price_minor       Int    @map("price_minor")
  currency          String @default("USD")
  status            String @default("active")
  provider          String @default("store")
  created_at        String @map("created_at")
  updated_at        String @map("updated_at")

  @@unique([skin_id])
  @@map("skin_products")
}

// 皮肤订单：自包含生命周期（不复用基础设施 orders 表）。同 (user, 幂等键) 同单；
// status: pending → processing → success | failed（refunded 预留）。
model SkinOrder {
  id                   String  @id
  user_id              String  @map("user_id")
  skin_id              String  @map("skin_id")
  entitlement_key      String  @map("entitlement_key")
  idempotency_key      String  @map("idempotency_key")
  amount_minor         Int     @map("amount_minor")
  currency             String
  provider             String
  store_product_id     String  @default("") @map("store_product_id")
  status               String  @default("pending")
  store_transaction_id String  @default("") @map("store_transaction_id")
  receipt_hash         String  @default("") @map("receipt_hash")
  created_at           String  @map("created_at")
  completed_at         String? @map("completed_at")

  @@unique([user_id, idempotency_key])
  @@index([user_id, status])
  @@map("skin_orders")
}

// 皮肤权益（所有权数据）：皮肤为非消耗型买断，expires_at 恒空（保留列对齐
// 通用权益形态）；退款撤销置 active=false。
model SkinEntitlement {
  id              String  @id
  user_id         String  @map("user_id")
  entitlement_key String  @map("entitlement_key")
  source_order_id String  @map("source_order_id")
  active          Boolean @default(true)
  expires_at      String? @map("expires_at")
  created_at      String  @map("created_at")

  @@unique([user_id, entitlement_key])
  @@map("skin_entitlements")
}
