# 本 app 的业务 Postgres（境内 Docker / Neon / Supabase 均可，换库只改这里）
DATABASE_URL=postgresql://user:password@localhost:5432/biz

# 共享基础设施地址；必须与签发 JWT 的 issuer 一致
AUTH_BASE_URL=https://auth.zhongbei.tech

# JWT audience；必须与基础设施 AUTH_JWT_AUDIENCE 一致
JWT_AUDIENCE=dsh-pocket

# 本 app 的租户 id（与客户端 x-app-id 一致；create 后由身份改写写入）
APP_ID=mobilestarter

# 遥测里标记本服务版本
APP_VERSION=1.0.0

# 基础设施内部接口密钥（调 auth /v1/internal/profiles 批量取昵称/头像；与 auth 侧一致）
INTERNAL_API_KEY=

# 服务间 client credentials（换内部服务 token；与 auth 侧 INTERNAL_CLIENT_SECRET 一致）
INTERNAL_CLIENT_ID=lofi-biz
INTERNAL_CLIENT_SECRET=
